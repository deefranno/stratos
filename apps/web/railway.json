{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ../.. && npm ci && npm run build -w @stratos/financial-engine && npm run build -w @stratos/web"
  },
  "deploy": {
    "startCommand": "cd apps/web && npx --yes serve dist -s -l $PORT",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
