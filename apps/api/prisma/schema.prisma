// Stratos Trucking Profit Navigator — PostgreSQL schema.
// Money is stored as exact Decimal(12,2); miles/gallons as Decimal(12,3).
// Calculated totals are NEVER stored — they are computed by the centralized
// financial engine (@stratos/financial-engine) so they can never drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

// ---------------- Better Auth core models ----------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  client        Client?
  auditLogs     AuditLog[]
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                   String    @id
  userId               String
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  idToken              String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------- Application models ----------------

model Client {
  id           String          @id @default(cuid())
  userId       String          @unique
  displayName  String
  businessName String?
  phone        String?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trucks       Truck[]
  subscription Subscription?
  tickets      SupportTicket[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Truck {
  id        String         @id @default(cuid())
  clientId  String
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  entries   MonthlyEntry[]

  @@unique([clientId, name])
  @@index([clientId])
}

model MonthlyEntry {
  id                 String   @id @default(cuid())
  truckId            String
  reportingMonth     String // "YYYY-MM"
  revenue            Decimal  @default(0) @db.Decimal(12, 2)
  fuelSpend          Decimal  @default(0) @db.Decimal(12, 2)
  gallonsPurchased   Decimal  @default(0) @db.Decimal(12, 3)
  totalMiles         Decimal  @default(0) @db.Decimal(12, 3)
  truckPayment       Decimal  @default(0) @db.Decimal(12, 2)
  insurance          Decimal  @default(0) @db.Decimal(12, 2)
  permits            Decimal  @default(0) @db.Decimal(12, 2)
  otherFixedCosts    Decimal  @default(0) @db.Decimal(12, 2)
  maintenance        Decimal  @default(0) @db.Decimal(12, 2)
  tires              Decimal  @default(0) @db.Decimal(12, 2)
  tolls              Decimal  @default(0) @db.Decimal(12, 2)
  otherVariableCosts Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  truck              Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)

  // Prevents duplicate entries for the same truck and month at the database level.
  @@unique([truckId, reportingMonth])
  @@index([truckId])
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  code          String         @unique // OWNER_OPERATOR | SMALL_FLEET | GROWING_FLEET
  name          String
  description   String?
  priceCents    Int
  currency      String         @default("USD")
  maxTrucks     Int
  active        Boolean        @default(false) // only Owner-Operator activates initially
  stripePriceId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                   String            @id @default(cuid())
  clientId             String            @unique
  planId               String
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  status               String            @default("inactive") // inactive|trialing|active|past_due|canceled
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan  @relation(fields: [planId], references: [id])

  @@index([status])
}

model SupportTicket {
  id        String   @id @default(cuid())
  clientId  String?
  subject   String
  message   String
  status    String   @default("open") // open|in_progress|resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // e.g. entry.create, entry.update, billing.checkout, admin.role_change
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}

model StripeWebhookEvent {
  id           String    @id @default(cuid())
  stripeEventId String   @unique // idempotency: each Stripe event processed at most once
  type         String
  payload      Json?
  processedAt  DateTime?
  error        String?
  createdAt    DateTime  @default(now())

  @@index([type])
}
