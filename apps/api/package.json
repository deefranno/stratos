{
  "name": "@stratos/api",
  "version": "0.1.0",
  "private": true,
  "description": "Stratos Trucking Profit Navigator API — Express + Prisma + Better Auth + Stripe",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@stratos/financial-engine": "*",
    "better-auth": "^1.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "stripe": "^18.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
