# ---- Core ----
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:3001
APP_URL=http://localhost:5173
# ---- Database (Railway PostgreSQL) ----
DATABASE_URL=postgresql://user:password@host:5432/stratos
# ---- Better Auth ----
AUTH_SECRET=generate-a-long-random-string
# ---- Stripe (TEST MODE ONLY until written authorization) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_OWNER_OPERATOR=price_...        # $20/month, activated first
STRIPE_PRICE_SMALL_FLEET=                     # $50/month, future
STRIPE_PRICE_GROWING_FLEET=                   # $100/month, future
# Feature gate: set to true in production so unsubscribed accounts are blocked.
REQUIRE_ACTIVE_SUBSCRIPTION=false
# ---- Bootstrap ----
ADMIN_EMAILS=admin@stratosfinancials.com
